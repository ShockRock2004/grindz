# dependencies
node_modules/

# build output
dist/
dist-ssr/
dev-dist/
build/
web-build/
.expo/
*.local

# native build artifacts
.cxx/
.gradle/
local.properties
# Signing material — NEVER commit.
# apps/mobile/android/app/debug.keystore signs the released APK: publishing it would let
# anyone build an update that installs over an existing Grindz install. Losing it means
# no future build can upgrade over one either — keep a private backup. See docs/BUILD.md.
*.keystore
*.jks
*.p12
*.p8
*.key
*.mobileprovision
keystore.properties

# secrets
.env
.env*.local

# tooling / editor
*.tsbuildinfo
expo-env.d.ts
.kotlin/
*.pem
.DS_Store
.claude/
.impeccable/
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*

# body-map trace intermediates (masks, .npy) — regenerate with apps/web/scripts/trace
apps/web/scripts/trace/build/
apps/web/scripts/trace/build-female/

# generated by `expo prebuild`; the Android project is committed on purpose (see docs/BUILD.md)
apps/mobile/ios/

# demo bundle built in development mode for verification (see apps/web/scripts/verify-web.mjs)
dist-demo/
verify-shots/

# scratchpad handoff notes — working state and traps, not documentation.
# The durable material lives in docs/ and in the commit messages.
HANDOFF.md
